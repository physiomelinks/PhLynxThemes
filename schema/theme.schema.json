{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cdn.jsdelivr.net/gh/physiomelinks/phlynx-themes@1/schema/theme.schema.json",
  "title": "PhLynx node colour theme",
  "description": "Names a set of node categories and gives each a colour. Nodes store only the category key.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "categories"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": {
      "description": "Stable identifier; also the file name in themes/.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,47}$"
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 64 },
    "description": { "type": "string", "maxLength": 280 },
    "author": { "type": "string", "maxLength": 64 },
    "license": { "type": "string", "maxLength": 64 },
    "derivedFrom": {
      "description": "Id of the shared theme this one started from.",
      "type": "string",
      "maxLength": 64
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "label", "color"],
        "properties": {
          "key": {
            "description": "What a node stores. Never change it once published: saved workspaces refer to it.",
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}$"
          },
          "label": { "type": "string", "minLength": 1, "maxLength": 32 },
          "color": { "$ref": "#/$defs/hex" },
          "dark": {
            "description": "Fill in dark mode. When left out, PhLynx mixes `color` into the dark surface.",
            "$ref": "#/$defs/hex"
          }
        }
      }
    }
  },
  "$defs": {
    "hex": { "type": "string", "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$" }
  }
}
